# ===== Required for the app to run =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server only - NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ===== Required for background processing & secrets =====
CRON_SECRET=                      # long random string; Vercel Cron sends it as a Bearer token to /api/worker/tick
CREDENTIAL_ENCRYPTION_KEY=        # 32 bytes base64: `openssl rand -base64 32` (webhook secrets, unsubscribe links)

# ===== Optional: AI (either provider; first one set is used unless AI_PROVIDER is set) =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=                      # openai | anthropic
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-5-5

# ===== Optional: e-mail (Resend) =====
RESEND_API_KEY=
EMAIL_FROM=LeadPilot <noreply@yourdomain.com>

# ===== Optional: billing (Stripe) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=            # webhook endpoint: <APP_URL>/api/webhooks/stripe

# ===== Optional: discovery connectors =====
GOOGLE_PLACES_API_KEY=            # Places API (New)

# ===== Optional: misc =====
NEXT_PUBLIC_CONTACT_EMAIL=
SENTRY_DSN=
